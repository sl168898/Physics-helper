+++ b/src/Data/Config/NameContains.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <algorithm>
+#include <string_view>
+
+namespace Data
+{
+	// The configured keyword is ASCII; leave non-ASCII name bytes unchanged.
+	[[nodiscard]] inline bool NameContains(
+		std::string_view a_name, std::string_view a_keyword, bool a_ignoreCase)
+	{
+		if (a_keyword.empty()) {
+			return false;
+		}
+		if (!a_ignoreCase) {
+			return a_name.find(a_keyword) != std::string_view::npos;
+		}
+		const auto fold = [](unsigned char c) -> unsigned char {
+			return c >= 'A' && c <= 'Z' ? static_cast<unsigned char>(c + ('a' - 'A')) : c;
+		};
+		return std::search(a_name.begin(), a_name.end(), a_keyword.begin(), a_keyword.end(),
+			[fold](unsigned char left, unsigned char right) { return fold(left) == fold(right); })
+			!= a_name.end();
+	}
+}
