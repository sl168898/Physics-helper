+	if (a_spell) {
+		const auto type = a_spell->data.spellType;
+		const bool isPowerType = type == RE::MagicSystem::SpellType::kPower ||
+			type == RE::MagicSystem::SpellType::kLesserPower ||
+			type == RE::MagicSystem::SpellType::kVoicePower;
