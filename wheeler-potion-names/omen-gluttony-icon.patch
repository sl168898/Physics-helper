diff --git a/src/bin/Wheeler/WheelItems/NamedPowerIcon.h b/src/bin/Wheeler/WheelItems/NamedPowerIcon.h
new file mode 100644
--- /dev/null
+++ b/src/bin/Wheeler/WheelItems/NamedPowerIcon.h
@@ -0,0 +1,25 @@
+// Omen of Gluttony icon compatibility, 2026-09-28. GPL-3.0-only.
+#pragma once
+#include <string_view>
+
+namespace NamedPowerIcon
+{
+    // Use the visible English name instead of a load-order-dependent FormID.
+    // Require an exact name and a power; ordinary spells and similarly named
+    // powers must retain their existing icon rules.
+    inline bool IsOmenOfGluttony(std::string_view name, bool isPower)
+    {
+        constexpr std::string_view expected = "omen of gluttony";
+        if (!isPower || name.size() != expected.size()) {
+            return false;
+        }
+        for (std::size_t i = 0; i < name.size(); ++i) {
+            const char c = name[i];
+            const char lower = c >= 'A' && c <= 'Z' ? static_cast<char>(c + ('a' - 'A')) : c;
+            if (lower != expected[i]) {
+                return false;
+            }
+        }
+        return true;
+    }
+}
