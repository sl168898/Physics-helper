diff --git a/src/bin/Wheeler/WheelItems/AlchemyBatch.h b/src/bin/Wheeler/WheelItems/AlchemyBatch.h
new file mode 100644
index 0000000..fa02a9f
--- /dev/null
+++ b/src/bin/Wheeler/WheelItems/AlchemyBatch.h
@@ -0,0 +1,52 @@
+// Rename Potions compatibility changes, 2026-09-19. GPL-3.0-only.
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace AlchemyBatch
+{
+    struct Stack
+    {
+        std::string name;
+        int count = 0;
+    };
+
+    struct Match
+    {
+        int count = 0;
+        std::optional<std::size_t> firstStack;
+    };
+
+    // Old wheel saves identify only the base form. Upgrade them only when every
+    // owned copy has the same custom name. Never guess between named batches.
+    inline void AdoptUnambiguousName(const std::vector<Stack>& stacks,
+        const std::string& baseName, std::optional<std::string>& binding)
+    {
+        if (binding) return;
+        const std::string* candidate = nullptr;
+        for (const auto& stack : stacks) {
+            if (stack.count <= 0) continue;
+            if (candidate && *candidate != stack.name) return;
+            candidate = &stack.name;
+        }
+        if (candidate && !candidate->empty() && *candidate != baseName) {
+            binding = *candidate;
+        }
+    }
+
+    inline Match Select(const std::vector<Stack>& stacks,
+        const std::optional<std::string>& binding)
+    {
+        Match result;
+        for (std::size_t i = 0; i < stacks.size(); ++i) {
+            const auto& stack = stacks[i];
+            if (stack.count <= 0 || (binding && stack.name != *binding)) continue;
+            result.count += stack.count;
+            if (!result.firstStack) result.firstStack = i;
+        }
+        return result;
+    }
+}
