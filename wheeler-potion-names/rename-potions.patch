+	// Refined retains inventory snapshots for 250 ms. Their ExtraDataList pointers
+	// can be freed by a consumed item before the next refresh. Cache owned strings
+	// at snapshot creation, never dereference those pointers on later draw frames.
+	using BatchNames = std::unordered_map<RE::FormID, std::vector<AlchemyBatch::Stack>>;
+	std::unordered_map<const RE::TESObjectREFR::InventoryItemMap*, BatchNames> cachedBatchNames;
+	std::mutex cachedBatchNamesMutex;
+
+	struct InventoryBatches
+	{
+		std::vector<AlchemyBatch::Stack> stacks;
+		std::vector<RE::ExtraDataList*> extraLists;
+	};
+
+	InventoryBatches DescribeBatches(RE::AlchemyItem* item, RE::TESObjectREFR::InventoryItemMap& inventory)
+	{
+		InventoryBatches result;
+		const auto found = inventory.find(item);
+		if (!item || found == inventory.end() || found->second.first <= 0) return result;
+		int remaining = found->second.first;
+		const char* baseName = item->GetName();
+		const auto* entry = found->second.second.get();
+		if (entry && entry->extraLists) {
+			std::unordered_set<RE::ExtraDataList*> seen;
+			for (auto* extra : *entry->extraLists) {
+				if (!extra || remaining <= 0 || !seen.insert(extra).second) continue;
+				const int count = (std::min)(remaining, (std::max)(0, static_cast<int>(extra->GetCount())));
+				if (count <= 0) continue;
+				const char* name = extra->GetDisplayName(item);
+				if (!name || !name[0]) name = baseName;
+				result.stacks.push_back({name ? name : "", count});
+				result.extraLists.push_back(extra);
+				remaining -= count;
+			}
+		}
+		if (remaining > 0) {
+			// Copies without extra data remain an ordinary, unnamed inventory stack.
+			result.stacks.push_back({baseName ? baseName : "", remaining});
+			result.extraLists.push_back(nullptr);
+		}
+		return result;
+	}
