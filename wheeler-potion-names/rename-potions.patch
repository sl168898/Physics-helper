 const char* WheelItemAlchemy::GetItemName() const
 {
+	if (_inventoryName) return _inventoryName->c_str();
 	RE::AlchemyItem* item = RE::TESForm::LookupByID<RE::AlchemyItem>(_formID);
 	return item ? item->GetName() : "(deleted)";
 }
+
+int WheelItemAlchemy::GetBatchCount(RE::TESObjectREFR::InventoryItemMap& inventory)
+{
+	auto* item = RE::TESForm::LookupByID<RE::AlchemyItem>(_formID);
+	if (!item) return 0;
+	const char* baseName = item->GetName();
+	{
+		std::lock_guard lock(cachedBatchNamesMutex);
+		if (const auto cached = cachedBatchNames.find(&inventory); cached != cachedBatchNames.end()) {
+			const auto found = cached->second.find(_formID);
+			if (found == cached->second.end()) return 0;
+			AlchemyBatch::AdoptUnambiguousName(found->second, baseName ? baseName : "", _inventoryName);
+			return AlchemyBatch::Select(found->second, _inventoryName).count;
+		}
+	}
+	// All other callers supply a fresh, local inventory snapshot.
+	const auto batches = DescribeBatches(item, inventory);
+	AlchemyBatch::AdoptUnambiguousName(batches.stacks, baseName ? baseName : "", _inventoryName);
+	return AlchemyBatch::Select(batches.stacks, _inventoryName).count;
+}
+
+void WheelItemAlchemy::CacheInventoryNames(RE::TESObjectREFR::InventoryItemMap& inventory)
+{
+	BatchNames names;
+	for (auto& [object, data] : inventory) {
+		if (object && data.first > 0) {
+			if (auto* item = object->As<RE::AlchemyItem>()) {
+				names.emplace(item->GetFormID(), DescribeBatches(item, inventory).stacks);
+			}
+		}
+	}
+	std::lock_guard lock(cachedBatchNamesMutex);
+	cachedBatchNames[&inventory] = std::move(names);
+}
+
+void WheelItemAlchemy::ForgetInventoryNames(RE::TESObjectREFR::InventoryItemMap& inventory)
+{
+	std::lock_guard lock(cachedBatchNamesMutex);
+	cachedBatchNames.erase(&inventory);
+}
+
+bool WheelItemAlchemy::EquipInventoryBatch(RE::FormID formID, const std::optional<std::string>& name)
+{
+	auto* pc = RE::PlayerCharacter::GetSingleton();
+	auto* manager = RE::ActorEquipManager::GetSingleton();
+	auto* item = RE::TESForm::LookupByID<RE::AlchemyItem>(formID);
+	if (!pc || !manager || !item) return false;
+	RE::TESObjectREFR::InventoryItemMap inventory;
+	if (!Utils::Inventory::TryGetInventorySnapshot(pc, inventory, "EquipAlchemyBatch")) return false;
+	const auto batches = DescribeBatches(item, inventory);
+	const auto match = AlchemyBatch::Select(batches.stacks, name);
+	if (match.count <= 0 || !match.firstStack) return false;
+	// Re-resolve the live stack immediately before use. Never retain an ExtraDataList
+	// across wheel frames, a pending poison dialog, or a save/load transition.
+	auto* extra = name ? batches.extraLists[*match.firstStack] : nullptr;
+	manager->EquipObject(pc, item, extra);
+	return true;
+}
