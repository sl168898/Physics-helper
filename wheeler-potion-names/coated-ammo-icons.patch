diff --git a/src/bin/Wheeler/WheelItems/PoisonedAmmoIcon.h b/src/bin/Wheeler/WheelItems/PoisonedAmmoIcon.h
new file mode 100644
--- /dev/null
+++ b/src/bin/Wheeler/WheelItems/PoisonedAmmoIcon.h
@@ -0,0 +1,21 @@
+// Coated-ammunition icon selection, 2026-09-30. GPL-3.0-only.
+#pragma once
+#include <cstdint>
+#include <string_view>
+
+namespace PoisonedAmmoIcon
+{
+    enum class Kind : std::uint8_t { Other, Arrow, Bolt, Unresolved };
+
+    inline Kind Select(std::string_view plugin, std::uint32_t localID, bool bolt)
+    {
+        constexpr std::string_view expected = "poisonedammonative.esp";
+        if (localID < 0x800 || localID >= 0xA00 || plugin.size() != expected.size()) return Kind::Other;
+        for (std::size_t i = 0; i < plugin.size(); ++i) {
+            const char c = plugin[i];
+            const char lower = c >= 'A' && c <= 'Z' ? static_cast<char>(c + ('a' - 'A')) : c;
+            if (lower != expected[i]) return Kind::Other;
+        }
+        return bolt ? Kind::Bolt : Kind::Arrow;
+    }
+}
