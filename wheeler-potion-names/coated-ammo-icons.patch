 }
 
+void WheelItemAmmo::RefreshPoisonIcon()
+{
+    if (!_ammo) return;
+    const auto file = _ammo->GetFile(0);
+    const auto localID = file ? _ammo->GetFormID() & (file->IsLight() ? 0xFFFu : 0xFFFFFFu) : 0u;
+    const auto kind = PoisonedAmmoIcon::Select(file ? file->GetFilename() : "", localID, _ammo->IsBolt());
+    if (kind == _poisonIconKind) return;
+    _poisonIconKind = kind;
+    if (kind == PoisonedAmmoIcon::Kind::Other) {
+        _texture = Texture::GetIconImage(Texture::icon_image_type::arrow, _ammo);
+        _preferNativeIcon = false;
+        return;
+    }
+    // Use the ordinary ammo theme's logical footprint, while the marked SVG
+    // retains its 2K raster and mip filtering. Never inherit a keyword override
+    // or imported I4 crossbow glyph for our stable coated-ammunition slots.
+    auto fallback = Texture::GetIconImage(Texture::icon_image_type::arrow, nullptr);
+    const bool bolt = kind == PoisonedAmmoIcon::Kind::Bolt;
+    auto icon = Texture::GetImageByPath(bolt ?
+        "Data/SKSE/Plugins/wheeler/resources/poisoned_ammo/poisoned_bolt.svg" :
+        "Data/SKSE/Plugins/wheeler/resources/poisoned_ammo/poisoned_arrow.svg");
+    if (icon.texture && icon.width > 0 && icon.height > 0) {
+        if (fallback.width > 0 && fallback.height > 0) {
+            // Both glyphs have square canvases; preserve their aspect ratio.
+            const auto size = (std::max)(fallback.width, fallback.height);
+            icon.width = icon.height = size;
+        }
+        _texture = icon;
+        logger::info("PoisonedAmmoIcon: native poisoned {} icon for {:08X}", bolt ? "bolt" : "arrow", _ammo->GetFormID());
+    } else {
+        _texture = fallback;
+        logger::warn("PoisonedAmmoIcon: missing {} SVG; using plain ammo fallback", bolt ? "bolt" : "arrow");
+    }
+    _preferNativeIcon = true;
+}
+
 void WheelItemAmmo::DrawSlot(ImVec2 a_center, bool a_hovered, RE::TESObjectREFR::InventoryItemMap& a_imap, DrawArgs a_drawArgs)
 {
+	RefreshPoisonIcon();
 	int ammoCount = a_imap.contains(this->_ammo) ? a_imap.find(this->_ammo)->second.first : 0;
 	std::string text = fmt::format("{} ({})", _ammo->GetName(), ammoCount);
 	this->drawSlotText(a_center, text.data(), a_drawArgs);
@@ -24,6 +61,7 @@
 
