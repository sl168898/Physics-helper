new file mode 100644
--- /dev/null
+++ b/src/bin/Integrations/PoisonedAmmoBridge.h
@@ -0,0 +1,37 @@
+// Optional Poisoned Ammunition integration. MIT, 2026 Physics-helper contributors.
+#pragma once
+#include <Windows.h>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace PoisonedAmmoBridge
+{
+    // Stable C ABI: 0 allows normal weapon poisoning; any other result claims
+    // the click, including a refused/failed coating request. The callee copies
+    // the optional name and enqueues game work before returning.
+    using CoatOneV1 = std::uint32_t (*)(std::uint32_t, const char*, std::uint32_t, std::uint32_t);
+
+    inline bool TryCoat(RE::AlchemyItem* poison, const std::optional<std::string>& name,
+        RE::FormID clickedWeapon, RE::FormID clickedAmmo)
+    {
+        const auto weapon = RE::TESForm::LookupByID<RE::TESObjectWEAP>(clickedWeapon);
+        const auto player = RE::PlayerCharacter::GetSingleton();
+        const auto equipped = player ? player->GetEquippedObject(false) : nullptr;
+        const auto now = equipped ? equipped->As<RE::TESObjectWEAP>() : nullptr;
+        const auto ranged = [](const RE::TESObjectWEAP* item) { return item && (item->IsBow() || item->IsCrossbow()); };
+        if (!poison || !poison->IsPoison() || (!ranged(weapon) && !ranged(now))) return false;
+        const auto module = GetModuleHandleW(L"PoisonedAmmoNative.dll");
+        if (!module) return false;
+        const auto coat = reinterpret_cast<CoatOneV1>(GetProcAddress(module, "PoisonedAmmoNative_CoatOneV1"));
+        if (!coat) {
+            RE::DebugNotification("Wheeler: update Poisoned Ammunition to 0.2.3 or newer for ammunition coating.");
+            logger::warn("PoisonedAmmoNative is loaded but its CoatOneV1 interface is absent; ranged poison use blocked");
+            return true;
+        }
+        const auto handled = coat(poison->GetFormID(), name ? name->c_str() : nullptr, clickedWeapon, clickedAmmo);
+        logger::info("Poisoned ammunition bridge: poison {:08X}; weapon {:08X}; ammo {:08X}; handled {}",
+            poison->GetFormID(), clickedWeapon, clickedAmmo, handled);
+        return handled != 0;
+    }
+}
