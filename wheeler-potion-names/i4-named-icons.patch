new file mode 100644
index 0000000..a60aea7
--- /dev/null
+++ b/src/bin/Integrations/EnchantmentSwapperBridge.cpp
@@ -0,0 +1,59 @@
+#include "EnchantmentSwapperBridge.h"
+#include <Windows.h>
+#include <cstdint>
+#include <vector>
+
+namespace EnchantmentSwapperBridge {
+namespace {
+using Query = std::uint32_t (*)(std::uint32_t objectID, std::uint32_t enchantmentID,
+    std::uint32_t ownerID, std::uint16_t uniqueID, char* buffer, std::uint32_t capacity);
+struct Identity {
+    std::uint32_t object{}, enchantment{}, owner{};
+    std::uint16_t unique{};
+};
+bool ReadIdentity(RE::TESBoundObject* object, RE::ExtraDataList* extras, Identity& result) {
+    if (!object || !extras) return false;
+    // Refined's rendering snapshot borrows engine extra lists. Follow its
+    // existing guarded-read convention; do not retain the pointer afterwards.
+#if defined(_MSC_VER)
+    __try {
+#endif
+        const auto* enchantment = extras->GetByType<RE::ExtraEnchantment>();
+        if (!enchantment || !enchantment->enchantment) return false;
+        result.object = object->GetFormID();
+        result.enchantment = enchantment->enchantment->GetFormID();
+        if (const auto* uid = extras->GetByType<RE::ExtraUniqueID>()) {
+            result.owner = uid->baseID;
+            result.unique = uid->uniqueID;
+        }
+        return true;
+#if defined(_MSC_VER)
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+        return false;
+    }
+#endif
+}
+Query GetQuery() {
+    static const Query query = [] {
+        const auto module = GetModuleHandleW(L"EnchantmentSwapperDescriptions.dll");
+        const auto function = module ? reinterpret_cast<Query>(GetProcAddress(module, "ESD_GetDescriptionV1")) : nullptr;
+        if (function) logger::info("Enchantment Swapper description bridge connected (API v1)");
+        else logger::info("Enchantment Swapper description API unavailable; keeping normal Wheeler descriptions");
+        return function;
+    }();
+    return query;
+}
+}
+bool GetDescription(RE::TESBoundObject* object, RE::ExtraDataList* extras, std::string& output) {
+    const auto query = GetQuery();
+    Identity identity{};
+    if (!query || !ReadIdentity(object, extras, identity)) return false;
+    const auto required = query(identity.object, identity.enchantment, identity.owner, identity.unique, nullptr, 0);
+    if (!required || required > 65536) return false;
+    std::vector<char> buffer(required, '\0');
+    const auto written = query(identity.object, identity.enchantment, identity.owner, identity.unique, buffer.data(), required);
+    if (!written || written > required || buffer.front() == '\0' || buffer.back() != '\0') return false;
+    output.assign(buffer.data());
+    return true;
+}
+}
