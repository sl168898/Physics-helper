diff --git a/src/bin/Integrations/I4/I4ResolveKey.h b/src/bin/Integrations/I4/I4ResolveKey.h
new file mode 100644
index 0000000..1b06265
--- /dev/null
+++ b/src/bin/Integrations/I4/I4ResolveKey.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <string>
+
+namespace I4Integration
+{
+	// Different inventory names can share one AlchemyItem FormID. Keep an owned
+	// name in the key so cache entries cannot bleed across renamed batches.
+	struct ResolveKey
+	{
+		std::uint32_t formID = 0;
+		std::uint64_t signature = 0;
+		std::string displayName;
+		bool operator==(const ResolveKey&) const = default;
+	};
+
+	struct ResolveKeyHash
+	{
+		std::size_t operator()(const ResolveKey& key) const
+		{
+			const std::uint64_t mixed = (static_cast<std::uint64_t>(key.formID) << 32) ^ key.signature;
+			const auto seed = std::hash<std::uint64_t>{}(mixed);
+			return seed ^ (std::hash<std::string>{}(key.displayName) +
+				0x9e3779b9u + (seed << 6) + (seed >> 2));
+		}
+	};
+}
