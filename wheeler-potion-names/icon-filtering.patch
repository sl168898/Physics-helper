new file mode 100644
--- /dev/null
+++ b/src/bin/Rendering/IconMipmaps.h
@@ -0,0 +1,90 @@
+// Copyright (c) 2026. SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <span>
+#include <utility>
+#include <vector>
+
+namespace IconMipmaps
+{
+    struct Level
+    {
+        int width = 0;
+        int height = 0;
+        std::vector<std::uint8_t> rgba;
+    };
+
+    // Store straight-alpha pixels for ImGui's existing blend state. Transparent
+    // pixels borrow colour only; their alpha remains zero. This avoids dark
+    // fringes when bilinear sampling crosses an otherwise empty texel.
+    inline void ExtendTransparentColors(Level& level)
+    {
+        for (int y = 0; y < level.height; ++y) {
+            for (int x = 0; x < level.width; ++x) {
+                const auto at = (static_cast<std::size_t>(y) * level.width + x) * 4;
+                if (level.rgba[at + 3] != 0) continue;
+                unsigned alpha = 0, rgb[3]{};
+                for (int dy = -1; dy <= 1; ++dy) {
+                    for (int dx = -1; dx <= 1; ++dx) {
+                        const int nx = x + dx, ny = y + dy;
+                        if (nx < 0 || nx >= level.width || ny < 0 || ny >= level.height) continue;
+                        const auto n = (static_cast<std::size_t>(ny) * level.width + nx) * 4;
+                        const unsigned a = level.rgba[n + 3];
+                        alpha += a;
+                        for (int c = 0; c < 3; ++c) rgb[c] += level.rgba[n + c] * a;
+                    }
+                }
+                if (alpha != 0) {
+                    for (int c = 0; c < 3; ++c) level.rgba[at + c] = static_cast<std::uint8_t>((rgb[c] + alpha / 2) / alpha);
+                }
+            }
+        }
+    }
+
+    inline std::vector<Level> Build(std::span<const std::uint8_t> pixels, int width, int height)
+    {
+        // Native HD raster targets never exceed 2048. The extra headroom keeps
+        // the helper usable independently while bounding accidental allocations.
+        if (width < 1 || height < 1 || width > 4096 || height > 4096 ||
+            pixels.size() != static_cast<std::size_t>(width) * height * 4) return {};
+        std::vector<Level> levels;
+        levels.push_back({width, height, {pixels.begin(), pixels.end()}});
+        ExtendTransparentColors(levels.back());
+        while (levels.back().width > 1 || levels.back().height > 1) {
+            const auto& src = levels.back();
+            Level dst;
+            dst.width = (std::max)(1, src.width / 2);
+            dst.height = (std::max)(1, src.height / 2);
+            dst.rgba.resize(static_cast<std::size_t>(dst.width) * dst.height * 4);
+            for (int y = 0; y < dst.height; ++y) {
+                const double y0 = static_cast<double>(y) * src.height / dst.height;
+                const double y1 = static_cast<double>(y + 1) * src.height / dst.height;
+                for (int x = 0; x < dst.width; ++x) {
+                    const double x0 = static_cast<double>(x) * src.width / dst.width;
+                    const double x1 = static_cast<double>(x + 1) * src.width / dst.width;
+                    double alpha = 0, rgb[3]{};
+                    for (int sy = static_cast<int>(y0); sy < static_cast<int>(std::ceil(y1)); ++sy) {
+                        const double wy = (std::min)(y1, static_cast<double>(sy + 1)) - (std::max)(y0, static_cast<double>(sy));
+                        for (int sx = static_cast<int>(x0); sx < static_cast<int>(std::ceil(x1)); ++sx) {
+                            const double wx = (std::min)(x1, static_cast<double>(sx + 1)) - (std::max)(x0, static_cast<double>(sx));
+                            const auto at = (static_cast<std::size_t>(sy) * src.width + sx) * 4;
+                            const double a = src.rgba[at + 3] * wx * wy;
+                            alpha += a;
+                            for (int c = 0; c < 3; ++c) rgb[c] += src.rgba[at + c] * a;
+                        }
+                    }
+                    const auto at = (static_cast<std::size_t>(y) * dst.width + x) * 4;
+                    dst.rgba[at + 3] = static_cast<std::uint8_t>(std::lround(alpha / ((x1 - x0) * (y1 - y0))));
+                    if (alpha > 0) {
+                        for (int c = 0; c < 3; ++c) dst.rgba[at + c] = static_cast<std::uint8_t>(std::lround(rgb[c] / alpha));
+                    }
+                }
+            }
+            ExtendTransparentColors(dst);
+            levels.push_back(std::move(dst));
+        }
+        return levels;
+    }
+}
diff --git a/src/bin/Rendering/IconTextureUpload.h b/src/bin/Rendering/IconTextureUpload.h
new file mode 100644
--- /dev/null
+++ b/src/bin/Rendering/IconTextureUpload.h
@@ -0,0 +1,55 @@
+// Copyright (c) 2026. SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "IconMipmaps.h"
+#include <d3d11.h>
+#include <wrl/client.h>
+#include <new>
+
+namespace IconTextureUpload
+{
+    inline D3D11_SAMPLER_DESC MipSamplerDescription()
+    {
+        D3D11_SAMPLER_DESC desc{};
+        desc.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+        desc.AddressU = desc.AddressV = desc.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+        desc.ComparisonFunc = D3D11_COMPARISON_NEVER;
+        desc.MaxAnisotropy = 1;
+        desc.MinLOD = 0.0f;
+        // ImGui 1.91.9's default sampler clamps this to 0, disabling mip selection.
+        desc.MaxLOD = D3D11_FLOAT32_MAX;
+        return desc;
+    }
+
+    inline HRESULT Create(ID3D11Device* device, std::span<const std::uint8_t> rgba,
+        int width, int height, ID3D11ShaderResourceView** output)
+    {
+        if (!device || !output) return E_INVALIDARG;
+        *output = nullptr;
+        try {
+        auto levels = IconMipmaps::Build(rgba, width, height);
+        if (levels.empty()) return E_INVALIDARG;
+        std::vector<D3D11_SUBRESOURCE_DATA> data;
+        data.reserve(levels.size());
+        for (const auto& level : levels) data.push_back({level.rgba.data(), static_cast<UINT>(level.width * 4), 0});
+        D3D11_TEXTURE2D_DESC desc{};
+        desc.Width = static_cast<UINT>(width);
+        desc.Height = static_cast<UINT>(height);
+        desc.MipLevels = static_cast<UINT>(levels.size());
+        desc.ArraySize = 1;
+        desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        desc.SampleDesc.Count = 1;
+        desc.Usage = D3D11_USAGE_IMMUTABLE;
+        desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        Microsoft::WRL::ComPtr<ID3D11Texture2D> texture;
+        const HRESULT created = device->CreateTexture2D(&desc, data.data(), texture.GetAddressOf());
+        if (FAILED(created)) return created;
+        D3D11_SHADER_RESOURCE_VIEW_DESC view{};
+        view.Format = desc.Format;
+        view.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+        view.Texture2D.MipLevels = desc.MipLevels;
+        return device->CreateShaderResourceView(texture.Get(), &view, output);
+        } catch (const std::bad_alloc&) {
+            return E_OUTOFMEMORY;
+        }
+    }
+}
