 }
 
 
+
+namespace
+{
+    // Draw callbacks execute inside ImGui's DX11 render pass. Binding before
+    // RenderDrawData would be ineffective: ImGui overwrites that sampler.
+    void BeginHDIconSampling(const ImDrawList*, const ImDrawCmd*)
+    {
+        auto* state = static_cast<ImGui_ImplDX11_RenderState*>(ImGui::GetPlatformIO().Renderer_RenderState);
+        if (!state || !state->Device || !state->DeviceContext) return;
+        struct Cache
+        {
+            Microsoft::WRL::ComPtr<ID3D11Device> device;
+            Microsoft::WRL::ComPtr<ID3D11SamplerState> sampler;
+            bool attempted = false;
+            bool logged = false;
+        };
+        static Cache cache;
+        if (cache.device.Get() != state->Device) {
+            cache.sampler.Reset();
+            cache.device = state->Device;
+            cache.attempted = cache.logged = false;
+        }
+        if (!cache.attempted) {
+            cache.attempted = true;
+            const auto desc = IconTextureUpload::MipSamplerDescription();
+            const HRESULT result = state->Device->CreateSamplerState(&desc, cache.sampler.GetAddressOf());
+            if (FAILED(result)) {
+                logger::warn("Texture: HD mip sampler creation failed (HRESULT={}); retaining default sampling",
+                    static_cast<unsigned long>(result));
+            }
+        }
+        if (!cache.sampler) return;
+        auto* sampler = cache.sampler.Get();
+        state->DeviceContext->PSSetSamplers(0, 1, &sampler);
+        if (!cache.logged) {
+            logger::info("Texture: HD mip filtering active (trilinear, full mip range; icon draws only)");
+            cache.logged = true;
+        }
+    }
+}
 
