diff --git a/src/bin/Rendering/IconRasterPolicy.h b/src/bin/Rendering/IconRasterPolicy.h
new file mode 100644
--- /dev/null
+++ b/src/bin/Rendering/IconRasterPolicy.h
@@ -0,0 +1,33 @@
+// Optional HD artwork textures, independent of Wheeler's logical draw size.
+#pragma once
+#include <algorithm>
+#include <cmath>
+
+namespace IconRasterPolicy
+{
+    struct Plan
+    {
+        int width;
+        int height;
+        float scale;
+    };
+
+    inline Plan MakePlan(int logicalWidth, int logicalHeight, unsigned requested)
+    {
+        Plan plan{ logicalWidth, logicalHeight, 1.0f };
+        // This build opts in only artwork marked with a supported target size.
+        // Themes, backgrounds, unmarked icons and raster files remain untouched.
+        if (logicalWidth <= 0 || logicalHeight <= 0 ||
+            (requested != 1024 && requested != 2048)) {
+            return plan;
+        }
+        const int largest = (std::max)(logicalWidth, logicalHeight);
+        if (largest >= static_cast<int>(requested)) {
+            return plan;
+        }
+        plan.scale = static_cast<float>(requested) / static_cast<float>(largest);
+        plan.width = (std::max)(1, static_cast<int>(std::lround(logicalWidth * plan.scale)));
+        plan.height = (std::max)(1, static_cast<int>(std::lround(logicalHeight * plan.scale)));
+        return plan;
+    }
+}
